<Window x:Class="lista1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lista 1 --- Programowanie 3"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <TabControl>


        <TabItem Header="Zadanie 1 - Kalkulator">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Height="50"
                         FontSize="24"
                         Text="0"
                         IsReadOnly="True"
                         Margin="0,0,0,10"/>

                <UniformGrid Grid.Row="1" Columns="4" Rows="4">
                    <Button Content="7" FontSize="22" Margin="3"/>
                    <Button Content="8" FontSize="22" Margin="3"/>
                    <Button Content="9" FontSize="22" Margin="3"/>
                    <Button Content="/" FontSize="22" Margin="3"/>

                    <Button Content="4" FontSize="22" Margin="3"/>
                    <Button Content="5" FontSize="22" Margin="3"/>
                    <Button Content="6" FontSize="22" Margin="3"/>
                    <Button Content="*" FontSize="22" Margin="3"/>

                    <Button Content="1" FontSize="22" Margin="3"/>
                    <Button Content="2" FontSize="22" Margin="3"/>
                    <Button Content="3" FontSize="22" Margin="3"/>
                    <Button Content="-" FontSize="22" Margin="3"/>

                    <Button Content="C" FontSize="22" Margin="3"/>
                    <Button Content="0" FontSize="22" Margin="3"/>
                    <Button Content="=" FontSize="22" Margin="3"/>
                    <Button Content="+" FontSize="22" Margin="3"/>
                </UniformGrid>
            </Grid>
        </TabItem>


        <TabItem Header="Zadanie 2 - Student">
            <StackPanel Margin="30" Width="350"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="Formularz studenta"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <Label Content="Imię:"/>
                <TextBox Height="30" Margin="0,0,0,10"/>

                <Label Content="Nazwisko:"/>
                <TextBox Height="30" Margin="0,0,0,10"/>

                <Label Content="Data urodzenia:"/>
                <DatePicker Height="30" Margin="0,0,0,10"/>

                <Label Content="Semestr:"/>
                <ComboBox Height="30" Margin="0,0,0,20">
                    <ComboBoxItem Content="Semestr 1"/>
                    <ComboBoxItem Content="Semestr 2"/>
                    <ComboBoxItem Content="Semestr 3"/>
                    <ComboBoxItem Content="Semestr 4"/>
                    <ComboBoxItem Content="Semestr 5"/>
                    <ComboBoxItem Content="Semestr 6"/>
                </ComboBox>

                <Button Content="Dodaj studenta"
                        Height="35"
                        FontSize="14"/>
            </StackPanel>
        </TabItem>


        <TabItem Header="Zadanie 3 - DockPanel">
            <DockPanel>
                <Button Content="Bottom" DockPanel.Dock="Bottom" Height="50"/>
                <Button Content="Left" DockPanel.Dock="Left" Width="60"/>
                <Button Content="Right" DockPanel.Dock="Right" Width="60"/>
                <Button Content="Top" DockPanel.Dock="Top" Background="Red" Height="90"/>
                <Button Content="Top2" DockPanel.Dock="Top" Background="Green" Height="120" Width="120" HorizontalAlignment="Center"/>
                <Button Content="Right2" DockPanel.Dock="Right" Width="45" Height="76"/>
                <Button Content="Right3" DockPanel.Dock="Right" Width="45" Height="76"/>
                <Button Content="Top3" DockPanel.Dock="Top" Background="Blue" Foreground="White" Height="70"/>
                <Button Content="Fill"/>
            </DockPanel>
        </TabItem>


        <TabItem Header="Zadanie 4 - Drzewo">
            <Canvas Background="White" Margin="10">

                <Line X1="390" Y1="100" X2="250" Y2="180"
                      Stroke="Black" StrokeThickness="2"/>
                <Line X1="390" Y1="100" X2="530" Y2="180"
                      Stroke="Black" StrokeThickness="2"/>

                <Line X1="250" Y1="230" X2="170" Y2="300"
                      Stroke="Black" StrokeThickness="2"/>
                <Line X1="250" Y1="230" X2="330" Y2="300"
                      Stroke="Black" StrokeThickness="2"/>

                <Line X1="530" Y1="230" X2="450" Y2="300"
                      Stroke="Black" StrokeThickness="2"/>
                <Line X1="530" Y1="230" X2="610" Y2="300"
                      Stroke="Black" StrokeThickness="2"/>

                <Button Content="1" Width="55" Height="40"
                        Canvas.Left="362" Canvas.Top="60"/>

                <Button Content="2" Width="55" Height="40"
                        Canvas.Left="222" Canvas.Top="180"/>

                <Button Content="3" Width="55" Height="40"
                        Canvas.Left="502" Canvas.Top="180"/>

                <Button Content="4" Width="55" Height="40"
                        Canvas.Left="142" Canvas.Top="300"/>

                <Button Content="5" Width="55" Height="40"
                        Canvas.Left="302" Canvas.Top="300"/>

                <Button Content="6" Width="55" Height="40"
                        Canvas.Left="422" Canvas.Top="300"/>

                <Button Content="7" Width="55" Height="40"
                        Canvas.Left="582" Canvas.Top="300"/>

                <Label Content="Drzewo binarne - poziom 3"
                       FontSize="20"
                       Canvas.Left="240"
                       Canvas.Top="10"/>

            </Canvas>
        </TabItem>

    </TabControl>
</Window>