<Window x:Class="Zadanie3Lista2.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gra w statki"
        Height="650" Width="550"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <TextBlock x:Name="Status"
                       Text="Ustaw swoje statki"
                       FontSize="22"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="5,5,5,15"/>

            <TextBlock Text="Twoja plansza"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,5"/>

            <UniformGrid x:Name="OwnBoard"
                         Rows="5" Columns="5"
                         HorizontalAlignment="Center"/>

            <TextBlock Text="Plansza przeciwnika — strzelaj tutaj"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,20,0,5"/>

            <UniformGrid x:Name="EnemyBoard"
                         Rows="5" Columns="5"
                         HorizontalAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</Window>
