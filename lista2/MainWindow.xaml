<Window x:Class="lista2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalkulator"
        Height="450" Width="800">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="ekran"
                 Grid.Row="0"
                 Height="50"
                 FontSize="24"
                 Text="0"
                 IsReadOnly="True"
                 TextAlignment="Right"
                 Margin="0,0,0,10"/>

        <UniformGrid Grid.Row="1" Columns="4" Rows="4">
            <Button Content="7" Click="Liczba_Click" FontSize="22" Margin="3"/>
            <Button Content="8" Click="Liczba_Click" FontSize="22" Margin="3"/>
            <Button Content="9" Click="Liczba_Click" FontSize="22" Margin="3"/>
            <Button Content="/" Click="Znak_Click" FontSize="22" Margin="3"/>

            <Button Content="4" Click="Liczba_Click" FontSize="22" Margin="3"/>
            <Button Content="5" Click="Liczba_Click" FontSize="22" Margin="3"/>
            <Button Content="6" Click="Liczba_Click" FontSize="22" Margin="3"/>
            <Button Content="*" Click="Znak_Click" FontSize="22" Margin="3"/>

            <Button Content="1" Click="Liczba_Click" FontSize="22" Margin="3"/>
            <Button Content="2" Click="Liczba_Click" FontSize="22" Margin="3"/>
            <Button Content="3" Click="Liczba_Click" FontSize="22" Margin="3"/>
            <Button Content="-" Click="Znak_Click" FontSize="22" Margin="3"/>

            <Button Content="C" Click="Czysc_Click" FontSize="22" Margin="3"/>
            <Button Content="0" Click="Liczba_Click" FontSize="22" Margin="3"/>
            <Button Content="=" Click="Wynik_Click" FontSize="22" Margin="3"/>
            <Button Content="+" Click="Znak_Click" FontSize="22" Margin="3"/>
        </UniformGrid>
    </Grid>
</Window>
